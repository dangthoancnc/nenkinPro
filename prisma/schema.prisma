generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  COLLABORATOR
}

model User {
  id        String  @id @default(uuid())
  email     String  @unique
  password  String
  name      String
  role      Role    @default(COLLABORATOR)
  staffCode String? @unique

  customers Customer[]

  sessions          StaffSession[]
  templateDrafts    TemplateDraft[]
  notifications     Notification[]
  conversationParticipants ConversationParticipant[]
  sentMessages      Message[]
  activityFeeds     ActivityFeed[]
  assignedApplications NenkinApplication[] @relation("AssignedStaff")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("nenkin_users")
}

model StaffSession {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  ipHash     String?
  userAgent  String?

  @@index([userId])
  @@index([expiresAt])
  @@map("nenkin_staff_sessions")
}

model CustomerSession {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  ipHash     String?
  userAgent  String?

  @@index([customerId])
  @@index([expiresAt])
  @@map("nenkin_customer_sessions")
}

model OcrResult {
  id           String   @id @default(uuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  documentType String   // Ví dụ: 'zairyuFront', 'passport'
  rawData      Json     // Lưu toàn bộ cục JSON do AI trả về
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Mỗi khách hàng chỉ có 1 bản lưu OCR mới nhất cho mỗi loại giấy tờ
  @@unique([customerId, documentType]) 
  @@map("nenkin_ocr_results")
}

model TemplateDraft {
  id             String   @id @default(uuid())

  /// ID của DocumentTemplate trong static registry (kebab-case)
  templateId     String

  /// Version ID trong registry làm gốc để fork
  baseVersionId  String

  /// Số thứ tự draft: tự tăng theo templateId
  draftNumber    Int

  /// Nội dung fieldMappings JSON — phải pass FieldMappingSchema[]
  fieldMappings  Json

  changeNote     String
  createdById    String

  /// User tạo draft — relation tới model User hiện có
  createdBy      User     @relation(fields: [createdById], references: [id])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([templateId, draftNumber])
  @@index([templateId])
  @@index([createdById])
  @@map("nenkin_template_drafts")
}

model Customer {
  id          String         @id @default(uuid())
  code        String         @unique
  cardNumber  String?        @unique
  fullName    String
  dob         DateTime
  passwordPin String?
  pinResetRequired Boolean @default(false)
  status      CustomerStatus @default(NEW)

  zairyuAddress       String?
  zairyuRomajiAddress String?
  postalCode          String?
  taxOfficeId         String?
  nenkinNumber        String?
  nenkinKatakanaName  String?

  nenkinBookUrl     String?
  zairyuFrontUrl    String?
  zairyuBackUrl     String?
  passportUrl       String?
  departureStampUrl String?
  contactImageUrls  String[] @default([])
  
  bankAccounts      BankAccount[]
  securityPhotoUrl  String? // Chứa ảnh chụp chân dung bảo mật

  lastName               String?
  firstName              String?
  fullNameFurigana       String?
  nationality            String?
  sex                    String?
  placeOfBirth           String?
  passportIssueDate      DateTime?
  passportExpiryDate     DateTime?
  passportNumber         String?
  phone                  String?
  overseasAddress        String?
  overseasCountry        String?
  hasPermanentResidence  Boolean?
  permanentResidenceDate DateTime?
  myNumber               String?
  occupation             String?
  departureDate          DateTime?
  headOfHouseholdName    String?
  relationshipToHead     String?
  pensionSystemRegistrationNumber String?

  overseasStreet         String?
  overseasCity           String?
  overseasProvince       String?
  overseasPostalCode     String?

  applications     NenkinApplication[]
  workHistories    WorkHistory[]
  ocrResults       OcrResult[]
  sessions         CustomerSession[]
  notifications    Notification[]
  conversationParticipants ConversationParticipant[]
  sentMessages     Message[]

  createdBy   User?   @relation(fields: [createdById], references: [id])
  createdById String?

  zaloContact            String?
  facebookContact        String?
  referralCode           String?        @unique
  referredByCode         String?

  referralType          ReferralType?
  referredByCustomerId  String?
  referredByCustomer    Customer?  @relation("CustomerReferrals", fields: [referredByCustomerId], references: [id], onDelete: SetNull)
  referrals             Customer[] @relation("CustomerReferrals")

  taxOffice TaxOffice? @relation(fields: [taxOfficeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("nenkin_customers")
}

enum CustomerStatus {
  NEW
  PENDING
  VERIFIED
}

enum ReferralType {
  STAFF
  CUSTOMER
}

enum ApplicationStatus {
  PENDING
  DRAFT
  REVISION_REQUIRED
  SENT_1ST
  RECEIVED_1ST
  SENT_2ND
  RECEIVED_2ND
  COMPLETED
  CANCELLED
}

model NenkinApplication {
  id         String @id @default(uuid())
  status ApplicationStatus @default(DRAFT)
  revisionNote String? // Ghi chú yêu cầu sửa chữa từ nhân viên
  isReturnedToJapan Boolean @default(false) // Cờ đánh dấu khách hàng đã quay lại Nhật (Tự khai thuế, không cần đại diện)

  applyDate       DateTime?
  sent1stDate     DateTime?
  received1stDate DateTime?
  sent2ndDate     DateTime?
  received2ndDate DateTime?

  // --- Lần 1 & Notice of Payment ---
  noticeDate      DateTime? // Ngày ra thông báo cấp Lần 1
  noticeImageUrl  String?   // Ảnh chụp Phiếu thông báo Lần 1
  
  totalExpectedJpy Decimal? // 支給額 - Tổng tiền
  received1stJpy   Decimal? // 控除後支払額 - Tiền thực nhận Lần 1
  received2ndJpy   Decimal? // Thực nhận Lần 2
  tax2ndJpy        Decimal? // 所得税額 - Tiền thuế Lần 2 (Access ThueLan2)
  withheldTax      Decimal? // Thuế đã khấu trừ (源泉徴収税額) 20.42%

  serviceFeeJpy Decimal?
  exchangeRate  Decimal?
  serviceFeeVnd Decimal?
  
  referralBonusJpy    Decimal?  // +2000 JPY commission cho CTV giới thiệu
  referralDiscountJpy Decimal?  // -2000 JPY giảm giá cho khách hàng được giới thiệu
  
  targetGroup   String?    // Equivalent to DoiTuong from Access
  taxYear       Int?       // Năm khai thuế Reiwa
  workYears     Int?       // Số năm làm việc

  // --- Notice of Entitlement Detail Fields (脱退一時金支給決定通知書) ---
  coverageMonths              Int?     // 被保険者期間（実期間） - Số tháng tham gia BH
  lastCoverageMonth           String?  // 最終月 - Tháng đóng BH cuối cùng (VD: 2025-11)
  paymentsMultiplier          Decimal? // 支給率 - Hệ số thanh toán (VD: 2.7)
  averageStandardRemuneration Decimal? // 平均標準報酬(月)額 - Lương bình quân (VD: 226970)
  lumpSumWithdrawalNumber     String?  // 脱退一時金整理番号 - Mã số thụ hưởng Lần 1 (VD: 42650954055050)

  // --- Thuế Bảng 3 & Override Fields ---
  tokureiTekio               String?  // 特例適用条文 (VD: 171)
  tokureiShohoMark           Boolean? // Khoanh chọn 所法
  calculatedTax              Decimal? // Thuế đã tính (mục 49 / 92)
  calculatedTax93            Decimal? // Thuế đã tính (mục 93)
  totalGeneralTax            Decimal? // Tổng số thuế thông thường (mục 12)
  taxableRetirementIncome    Decimal? // Thu nhập chịu thuế (mục 76)
  retirementDeductionAmount  Decimal? // Mức miễn giảm thu nhập (退職所得控除額)

  // --- Nội dung ủy quyền Lần 1 (委任内容) ---
  delegateClaim    Boolean @default(true)  // Mục 3: Xin nhận tiền Nenkin (年金の請求)
  delegatePeriod   Boolean @default(false) // Mục 1: Tra cứu thời gian tham gia BH (年金の加入期間)
  delegateEstimate Boolean @default(false) // Mục 2: Ước tính số tiền Nenkin (年金の見込額)
  delegateReissue  Boolean @default(false) // Mục 4: Xin cấp lại sổ/giấy chứng nhận Nenkin (年金手帳等の再交付)
  delegateOther    Boolean @default(false) // Mục 5: Khác (その他)
  delegateOtherText String?                // Chi tiết nội dung khác

  customerId          String
  customer            Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  taxRepresentativeId String?
  taxRepresentative   TaxRepresentative?  @relation(fields: [taxRepresentativeId], references: [id])

  assignedUserId      String?
  assignedUser        User?               @relation("AssignedStaff", fields: [assignedUserId], references: [id], onDelete: SetNull)
  assignedAt          DateTime?

  histories           ApplicationHistory[]
  conversations       Conversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("nenkin_applications")
}

model ApplicationHistory {
  id            String             @id @default(uuid())
  applicationId String
  application   NenkinApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actorName     String
  action        String
  description   String
  createdAt     DateTime           @default(now())

  @@index([applicationId])
  @@map("nenkin_application_histories")
}

model TaxRepresentative {
  id            String  @id @default(uuid())
  fullName      String
  fullNameKana  String?
  address       String
  postalCode    String
  phone         String?
  myNumber      String?
  relationship  String? @default("納税管理人")
  occupation    String? @default("会社員")
  dob           DateTime?
  
  bankName            String?
  branchName          String?
  accountNumber       String?
  accountName         String?
  accountNameKatakana String?
  isYucho             Boolean  @default(false)
  bankAccountType     String?  // 'ORDINARY' hoặc 'CURRENT'
  yuchoKigo           String?
  yuchoBango          String?

  applications  NenkinApplication[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("nenkin_tax_representatives")
}

model TaxOffice {
  id                String  @id @default(uuid())
  name              String
  romajiName        String?
  address           String
  romajiAddress     String?
  postalCode        String
  phone             String?
  mapUrl            String?
  websiteUrl        String?
  receptionInfo     String?
  notes             String?

  // --- Các trường thông tin phục vụ gửi hồ sơ và tra cứu chi tiết ---
  mailingName       String?  // 申告書等の郵送先 (Tên trung tâm/cục thuế nhận)
  mailingPostalCode String?  // 申告書等の郵送先 (Mã bưu điện nhận)
  mailingAddress    String?  // 申告書等の郵送先 (Địa chỉ nhận)
  jurisdiction      String?  // 管轄区域 (Khu vực quản lý)
  consultationPhone String?  // 電話相談の方 (SĐT tư vấn)
  generalPhone      String?  // 電話相談以外で税務署にご用の方 (SĐT hành chính)

  customers Customer[]

  @@map("nenkin_tax_offices")
}


model ExchangeRate {
  id        String   @id @default(uuid())
  date      DateTime @unique
  jpyToVnd  Decimal
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("nenkin_exchange_rates")
}

model WorkHistory {
  id             String    @id @default(uuid())
  customerId     String
  companyName    String
  companyAddress String?
  startDate      DateTime?
  endDate        DateTime?
  pensionType    String?   @default("厚生年金保険")

  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("nenkin_work_histories")
}

enum EntityType {
  CUSTOMER
  APPLICATION
}

model AuditLog {
  id          String     @id @default(uuid())
  entityId    String     // ID của Customer hoặc NenkinApplication
  entityType  EntityType // Loại đối tượng bị thay đổi
  fromState   String     // Trạng thái trước khi chuyển (vd: DRAFT)
  toState     String     // Trạng thái sau khi chuyển (vd: SENT_1ST)
  actionBy    String     // ID của người dùng (User hoặc Customer) thực hiện
  actionAt    DateTime   @default(now()) // Thời gian thực hiện chuyển đổi
  metadata    Json?      // Lưu JSON chi tiết: lý do từ chối (revision note), IP, User-Agent, hoặc các fields thay đổi quan trọng
  
  @@index([entityId, entityType])
  @@index([actionAt])
  @@map("nenkin_audit_logs")
}

model BankDictionary {
  id          String   @id @default(uuid())
  country     String   // 'JAPAN' | 'VIETNAM'
  bankName    String
  branchName  String?
  swiftCode   String?
  address     String?
  city        String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([country, bankName, branchName])
  @@map("nenkin_bank_dictionaries")
}

model BankAccount {
  id                  String   @id @default(uuid())
  customerId          String
  customer            Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  purpose             String   // 'FIRST_REFUND' | 'SECOND_REFUND' | 'BOTH'
  bankCountry         String   // 'JAPAN' | 'VIETNAM'
  bankPassbookUrls    String[] @default([])
  
  bankName            String?
  branchName          String?
  accountNumber       String?
  accountName         String?
  accountNameKatakana String?  
  
  swiftCode           String?
  bankBranchAddress   String?
  bankInstitutionCode String?
  branchCode          String?
  bankAccountType     String?  // ORDINARY (1) hoặc CURRENT (2)
  isYucho             Boolean  @default(false)
  yuchoKigo           String?
  yuchoBango          String?
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("nenkin_bank_accounts")
}

model Notification {
  id          String    @id @default(uuid())
  userId      String?   // Trỏ đến User (Staff / CTV)
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId  String?   // Trỏ đến Khách hàng
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title       String
  content     String
  type        String    @default("SYSTEM") // 'APPLICATION_STATUS' | 'CHAT_MESSAGE' | 'COMMISSION' | 'SYSTEM'
  isRead      Boolean   @default(false)
  link        String?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([customerId])
  @@index([createdAt])
  @@map("nenkin_notifications")
}

model Conversation {
  id               String                    @id @default(uuid())
  title            String?
  type             String                    @default("DIRECT") // 'DIRECT' | 'GROUP' | 'CUSTOMER_SUPPORT'
  isArchived       Boolean                   @default(false)
  assignedUserId   String?
  assignedUserName String?
  supportStatus    String                    @default("UNASSIGNED") // 'UNASSIGNED' | 'ASSIGNED' | 'RESOLVED'
  applicationId    String?
  application      NenkinApplication?        @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  participants     ConversationParticipant[]
  messages         Message[]
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@index([applicationId])
  @@index([assignedUserId])
  @@map("nenkin_conversations")
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String?      // Staff / CTV
  user           User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId     String?      // Khách hàng
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([userId])
  @@index([customerId])
  @@map("nenkin_conversation_participants")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUserId   String?      // Staff / CTV
  senderUser     User?        @relation(fields: [senderUserId], references: [id], onDelete: SetNull)
  senderCustomerId String?    // Khách hàng
  senderCustomer Customer?    @relation(fields: [senderCustomerId], references: [id], onDelete: SetNull)
  content        String
  attachments    Json?        // Danh sách URL ảnh/tệp đính kèm
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([createdAt])
  @@map("nenkin_messages")
}

model ActivityFeed {
  id          String   @id @default(uuid())
  userId      String?  // CTV hoặc Staff
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  actorName   String
  action      String   // 'NEW_CUSTOMER' | 'STATUS_CHANGE' | 'COMMISSION_EARNED' | 'POST'
  content     String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("nenkin_activity_feeds")
}

model FaqItem {
  id        String   @id @default(uuid())
  key       String   @unique
  label     String
  keywords  String[]
  answer    String   @db.Text
  isActive  Boolean  @default(true)
  order     Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("nenkin_faq_items")
}
